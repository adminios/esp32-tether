# --- Board: Waveshare ESP32-S3-Zero (4 MB flash) ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Logs go to UART0 (TX = GPIO43) because TinyUSB owns the USB-C port
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- USB: CDC-NCM network device ---
# For phones that only have the CDC-ECM driver, switch to:
#   CONFIG_TINYUSB_NET_MODE_ECM_RNDIS=y   (and remove the NCM line)
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="DIY"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="ESP32 Wi-Fi Adapter"
CONFIG_TINYUSB_DESC_SERIAL_STRING="000001"

# --- Routing: NAT from the USB side out through Wi-Fi ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCPIP_TASK_PRIO=20

# --- Wi-Fi throughput (no PSRAM used) ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32

# --- HTTP server: browsers send large headers ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
